# pink
server
{
    listen 8080;
    host 127.0.0.1;
    root www;
    index index.html;
    client_max_body_size 1000000;
    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;
    location /
    {
        methods GET POST DELETE;
        root /www;
        index index.html;
        directory_listing off;
    }
    location /uploads
    {
        methods POST;
        upload on;
        upload_path /www/uploads;
    }
    location /files
    {
        methods GET DELETE;
        root /www/files;
        directory_listing off;
        index index.html;
    }
    location /cgi-bin
    {
        methods GET POST;
        root /www/cgi-bin;
        cgi .py /usr/bin/python3;
    }
}

