# Primary site for the browser, upload, CGI and load checks.
server
{
    listen 18080;
    host 127.0.0.1;
    root evaluation/html/site;
    index index.html;
    client_max_body_size 1K;
    error_page 404 /not-found.html;

    location /
    {
        methods GET;
        directory_listing off;
    }
    location /other
    {
        methods GET;
        root evaluation/html/other;
        index second.html;
    }
    location /browse
    {
        methods GET;
        root evaluation/html/other;
        directory_listing on;
    }
    location /private
    {
        methods GET;
        root evaluation/html/other;
        directory_listing off;
    }
    location /old-page
    {
        methods GET;
        redirect /index.html;
    }
    location /uploads
    {
        methods GET POST DELETE;
        root evaluation/html/uploads;
        upload on;
        upload_path evaluation/html/uploads;
    }
    location /read-only
    {
        methods GET;
        root evaluation/html/uploads;
    }
    location /cgi-bin
    {
        methods GET POST;
        root evaluation/cgi;
        cgi .py /usr/bin/python3;
    }
}

# A separate interface and port with a different site and built-in error pages.
server
{
    listen 18081;
    host 127.0.0.2;
    root evaluation/html/other;
    index second.html;

    location /
    {
        methods GET;
        directory_listing off;
    }
}
