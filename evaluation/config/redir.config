server 
{
    listen 8080;
    server_name localhost;

    root www;
    index home.html;

    # Normal route
    location / 
	{
        methods GET POST;
        directory_listing on;
    }

    # Redirect /old to the home page
    location /old 
	{
        methods GET;
        redirect /;
    }

    # Redirect /google to Google
    location /google
	{
        methods GET;
        redirect https://www.google.com;
    }

    # Redirect /temporary to /home
    location /temporary 
	{
        methods GET;
        redirect /home;
    }

    # Redirect /youtube to YouTube
    location /codam 
	{
       methods GET;
       redirect http://www.codam.nl;
  
    }

    # Normal location serving a file
    location /home 
	{
        root www;
        index home.html;
        methods GET;
    }
}
