# being the comment sign for all config files
server
{
    listen 8080;
    host 127.0.0.1;
    server_name localhost;

    root ./www;
    index index.html;

    error_page 404 ./errors/404.html;
    error_page 500 ./errors/500.html;

    location /
    {
        methods GET;
    }

    location /images
    {
        root ./www/images;
        methods GET;
    }

    location /upload
    {
        methods POST;
        upload_dir ./uploads;
    }

    location /cgi-bin
    {
        methods GET POST;
        cgi .py /usr/bin/python3;
    }
}