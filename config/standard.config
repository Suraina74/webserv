# being the comment sign for all config files
server
{
    listen 127.0.0.1:8080;

    root /var/www;
    index index.html;

    client_max_body_size 1000000;

    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;

    location /
    {
        methods GET POST DELETE;
        root /var/www;
        index index.html;
        directory_listing off;
    }

    location /images
    {
        methods GET;
        root /var/www/images;
        directory_listing on;
    }

    location /upload
    {
        methods POST;
        upload on;
        upload_path /var/www/uploads;
    }

    location /files
    {
        methods GET DELETE;
        root /var/www/files;
        directory_listing off;
        index index.html;
    }

    location /old-page
    {
        methods GET;
        redirect /new-page;
    }

    location /cgi-bin
    {
        methods GET POST;
        root /var/www/cgi-bin;
        cgi .py /usr/bin/python3;
    }
}

server
{
    listen 127.0.0.1:8081;

    root /var/www/second;
    index index.html;

    client_max_body_size 500000;

    error_page 404 /404.html;

    location /
    {
        methods GET;
        root /var/www/second;
        index index.html;
        directory_listing off;
    }
}