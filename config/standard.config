# being the comment sign for all config files
server
{
    listen 8080;
    host 127.0.0.1;
    root www;
    index index.html;
    client_max_body_size 1000000;
    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;
    location /
    {
        methods GET POST DELETE;
        root /www;
        index index.html;
        directory_listing off;
    }
    location /images
    {
        methods GET;
        root /www/images;
        directory_listing on;
    }
    location /upload
    {
        methods POST;
        upload on;
        upload_path /www/uploads;
    }
    location /files
    {
        methods GET DELETE;
        root /www/files;
        directory_listing off;
        index index.html;
    }
    location /old-page
    {
        methods GET;
        redirect /new-page;
    }
    location /cgi-bin
    {
        methods GET POST;
        root /www/cgi-bin;
        cgi .py /usr/bin/python3;
    }
}

server
{
    listen 8080;
    host 127.0.0.1;

    root www;
    index index.html;

    client_max_body_size 500000;

    error_page 404 /404.html;

    location /
    {
        methods GET;
        root /www/second;
        index index.html;
        directory_listing off;
    }
}