# being the comment sign for all config files
server
{
    listen 8080;
    host 127.0.0.1;
    server_name localhost;

    root /var/www;
    index index.html;

    client_max_body_size 1000000;

    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;

    location /
    {
        methods GET;
        root /var/www;
        index index.html;
        directory_listing off;
    }

    location /images
    {
        methods GET;
        root /var/www/images;
        directory_listing on;
    }

    location /upload
    {
        methods POST;
        upload on;
        upload_path /var/www/uploads;
    }

    location /old
    {
        redirect /new;
    }
}