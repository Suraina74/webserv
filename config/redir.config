server 
{
    listen 8080;
    server_name localhost;

    root www;
    index index.html;

    # Normal route
    location / 
	{
        methods GET POST;
        directory_listing on;
    }

    # Redirect /old to /new
    location /old 
	{
        redirect /new;
    }

    # Redirect /google to Google
    location /google
	{
        methods GET;
        redirect https://www.google.com;
    }

    # Temporary redirect
    location /temporary 
	{
        redirect /home;
    }

    # Redirect /youtube to YouTube
    location /youtube 
	{
       redirect https://www.youtube.com;
    }

    # Normal location serving a file
    location /home 
	{
        root www;
        index index.html;
        methods GET;
    }
}